# Copy to .env and fill in. Never commit .env.

# Access token -- see README step 2.
IG_ACCESS_TOKEN=

# Optional. Auto-detected when blank (/me, or
# /me/assigned_instagram_accounts for a unified-login token).
IG_USER_ID=

# Host + version must match the setup shown in your Meta app dashboard:
#   API setup with Unified login  -> graph.facebook.com   (v27.0)
#   API setup with Facebook login -> graph.facebook.com   (v27.0)
#   API setup with Instagram login-> graph.instagram.com
# Bump IG_API_VERSION if you get a "version does not exist" error.
IG_API_VERSION=v27.0
IG_GRAPH_HOST=graph.facebook.com

# Optional: local Whisper model for enrich.py
WHISPER_MODEL=base.en

# Optional: clip sourcing for make_reel.py (clips.py).
# Pixabay: sign up, then the key is shown at https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Pexels: new keys are paused (Nov 2026); only useful if you already have one.
PEXELS_API_KEY=
